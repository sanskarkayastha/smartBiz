# NeonDB connection strings
# Get these from your NeonDB project dashboard (neon.tech)
# Each service gets its own database within the same NeonDB project
# Format: jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require

AUTH_DB_URL=jdbc:postgresql://<host>.neon.tech/auth_db?sslmode=require
INVENTORY_DB_URL=jdbc:postgresql://<host>.neon.tech/inventory_db?sslmode=require
CRM_DB_URL=jdbc:postgresql://<host>.neon.tech/crm_db?sslmode=require
SALES_DB_URL=jdbc:postgresql://<host>.neon.tech/sales_db?sslmode=require

# NeonDB credentials (same user across all databases in a project)
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_OmDWhbzF80uP

# JWT secret — change this to a strong random string in production
JWT_SECRET=your-secret-key-change-in-production-at-least-32-characters-long

# Cloudinary product images (backend only; never expose the API secret to clients)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=smartbiz_product_images

# Email verification (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
AUTH_EMAIL_ENABLED=true
AUTH_EMAIL_FROM=your-email@gmail.com
AUTH_EMAIL_DEV_LOG_OTP=false
AUTH_VERIFICATION_CODE_EXPIRY_MINUTES=10

# Google sign-in
AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
AUTH_PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_ALLOWED_REDIRECT_PREFIXES=http://localhost:3000/api/auth/google/callback,mobile://auth/callback
