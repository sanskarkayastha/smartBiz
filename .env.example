# NeonDB connection strings
# Get these from your NeonDB project dashboard (neon.tech)
# Each service gets its own database within the same NeonDB project
# Format: jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require

AUTH_DB_URL=jdbc:postgresql://<host>.neon.tech/auth_db?sslmode=require
INVENTORY_DB_URL=jdbc:postgresql://<host>.neon.tech/inventory_db?sslmode=require
CRM_DB_URL=jdbc:postgresql://<host>.neon.tech/crm_db?sslmode=require
SALES_DB_URL=jdbc:postgresql://<host>.neon.tech/sales_db?sslmode=require

# NeonDB credentials (same user across all databases in a project)
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_OmDWhbzF80uP

# JWT secret — change this to a strong random string in production
JWT_SECRET=your-secret-key-change-in-production-at-least-32-characters-long
